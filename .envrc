# Enter the Nix shell of flake.nix: the toolchain, and the endpoints of the dev container.
use flake

# Your overrides as plain KEY=VALUE, ignored by git. They win over what the shell sets.
dotenv_if_exists .env.local

# Your overrides that need a shell (export, PATH_add, a value computed by a command), ignored by git.
source_env_if_exists .envrc.local
